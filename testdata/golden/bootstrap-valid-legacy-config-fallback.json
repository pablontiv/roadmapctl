{
  "active_statuses": [
    "Pending",
    "Specified",
    "In Progress"
  ],
  "autonomy": "until_done",
  "compact_after_task_commit": true,
  "config_path": "docs/roadmap/.roadmapctl.toml",
  "config_source": "toml",
  "diagnostics": [
    {
      "id": "RMC_CONFIG_DEPRECATED_TOPLEVEL",
      "message": "top-level commit_style, auto_push, pr_mode are deprecated; move them under [gitflow]",
      "path": "docs/roadmap/.roadmapctl.toml",
      "severity": "warning"
    }
  ],
  "done_statuses": [
    "Completed",
    "Obsolete"
  ],
  "gitflow": {
    "auto_push": true,
    "base_branch": "",
    "branch_mode": "direct_push",
    "branch_style": "",
    "commit_style": "conventional",
    "pr_body_style": "",
    "pr_create": "never",
    "pr_title_style": ""
  },
  "helpers": {
    "where_active": "estado in [\"Pending\", \"Specified\", \"In Progress\"]",
    "where_leaf": "isIndex == false",
    "where_not_done": "not (estado in [\"Completed\", \"Obsolete\"])"
  },
  "kind": "roadmapctl/bootstrap",
  "loop_max_tasks": 0,
  "missing_settings": [
    "gitflow.base_branch"
  ],
  "outcome_close_verify": [],
  "parallel": true,
  "required_code_coverage": 85,
  "roadmap_root": "<fixture:valid-legacy-config-fallback>/docs/roadmap",
  "root": "<fixture:valid-legacy-config-fallback>",
  "rootline_version": "<rootline-version>",
  "status_values": {
    "blocked": "Blocked",
    "completed": "Completed",
    "in_progress": "In Progress",
    "obsolete": "Obsolete",
    "pending": "Pending",
    "specified": "Specified"
  },
  "summary": {
    "errors": 0,
    "infos": 0,
    "status": "warning",
    "warnings": 1
  },
  "version": 1
}
